# Alpaca market data (never expose these to the browser)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_TRADING_URL=https://paper-api.alpaca.markets

# Finnhub fundamentals, earnings, and company news
FINNHUB_API_KEY=

# ChatGPT / OpenAI (server-side only; used by Positions and list Summary)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase auth (URL + anon key; never put the service role key here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional outbound notification channels (server-side only)
# Shared bot token. Users pair their own chat/channel in Settings; they do not create a bot.
TELEGRAM_BOT_TOKEN=
# Optional override if getMe is blocked; otherwise the username is read from Telegram.
TELEGRAM_BOT_USERNAME=

# Email alerts use the Resend SDK. Put your real key here (replace re_xxxxxxxxx).
# Until you verify a domain in Resend, From must be onboarding@resend.dev
# and To must be the email on your Resend account.
RESEND_API_KEY=re_xxxxxxxxx
NOTIFICATION_FROM_EMAIL=Trader Otto <onboarding@resend.dev>
